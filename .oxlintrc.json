{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-perf", "jsx-a11y", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@fontsource*/**"]
      }
    ]
  },
  "ignorePatterns": [".agents", ".claude", ".turbo", "dist", "out", "release", "node_modules"],
  "overrides": [
    {
      "files": [
        "apps/desktop/src/main/**",
        "apps/desktop/src/preload/**",
        "apps/desktop/electron.vite.config.ts",
        "apps/server/**"
      ],
      "env": {
        "node": true,
        "browser": false
      }
    },
    {
      // The shadcn CLI generates this code. These rules flag shadcn's own patterns (ARIA roles on
      // divs, effects that sync state from matchMedia), so they stay off to keep the code upstream.
      "files": ["packages/ui/src/**"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "react/set-state-in-effect": "off",
        "react/no-unstable-nested-components": "off",
        "no-shadow": "off",
        "no-underscore-dangle": "off"
      }
    }
  ]
}
