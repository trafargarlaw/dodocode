{
  "name": "dodocode",
  "private": true,
  "description": "A desktop app for working with coding agents",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "package": "turbo run package",
    "dist": "turbo run dist",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "trace": "turbo run build --filter=@dodocode/desktop --output-logs=errors-only && node apps/desktop/scripts/trace.mjs",
    "perfq": "cargo run --quiet --release --manifest-path tools/perfq/Cargo.toml --"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1"
}
