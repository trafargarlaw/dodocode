{
  "extends": "@dodocode/typescript-config/base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,

    "paths": {
      "@/*": ["./src/renderer/*"]
    }
  },
  "include": ["src/renderer"]
}
